APP_NAME="Med Fusion OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Porta exposta pelo container laravel.test — fixa em 8000 pra bater com APP_URL acima, o
# frontend Angular (environment.ts) e o README.
APP_PORT=8000

# UID/GID do usuário "sail" dentro do container — em Linux/macOS o script ./vendor/bin/sail
# exporta isso automaticamente (casando com o dono dos arquivos no host); no Windows não existe
# esse conceito, então fixamos um valor convencional.
WWWUSER=1000
WWWGROUP=1000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# URL do frontend Angular, usada para montar o CORS e links de retorno.
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Em produção (Laravel Cloud) estas quatro são injetadas automaticamente pela plataforma
# quando um cluster Laravel MySQL é anexado ao environment — não sobrescrever no painel.
# Ver docs/ambientes.md. Em local, DB_HOST=mysql resolve pelo nome do serviço no
# docker-compose.yml (container laravel.test → container mysql, mesma rede do Compose).
DB_CONNECTION=mysql
DB_HOST=mysql
# 3306 é a porta interna real do MySQL dentro da rede do Compose — é o que laravel.test usa pra
# falar com "mysql". Pra acessar de fora do Docker (ex.: um client de banco), use
# FORWARD_DB_PORT (mude o valor abaixo se já tiver outro MySQL local na 3306).
DB_PORT=3306
FORWARD_DB_PORT=3306
DB_DATABASE=medfusion_os
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# redis a partir daqui (cache de listagens, ver docs/architecture.md § Cache) — antes era
# "database". O servidor real é Valkey (fork open-source do Redis, mesmo protocolo — ver
# docker-compose.yml), mas CACHE_STORE=redis e REDIS_* continuam se chamando assim: é a
# nomenclatura do driver do Laravel, não o nome do software rodando. REDIS_HOST=valkey resolve
# pelo nome do serviço no docker-compose.yml, mesma rede do Compose que DB_HOST=mysql já usa.
CACHE_STORE=redis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=database

# Minutos até um token Sanctum expirar (default no config/sanctum.php: 30 dias). Ver
# api-conventions.md § Autenticação — corrigido no code review de 13/09/2026 (era null/nunca
# expira).
# SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Em produção: driver S3-compatível do Laravel Cloud Object Storage (credenciais injetadas
# automaticamente pela plataforma). Em local, "local" é suficiente — a v1 não depende de
# arquivos persistentes fora do fluxo de geração de PDF.
FILESYSTEM_DISK=local

# Notificação automática da OS por e-mail e WhatsApp (ver docs/ambientes.md e
# docs/api-conventions.md — ainda não implementada). Em local, aponta pro Mailpit (container
# atrás do profile "extra" do docker-compose.yml — `docker compose --profile extra up -d`),
# que captura os e-mails sem enviar de verdade. Painel em http://localhost:8025.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="naoresponda@medfusion.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Cloud API (Meta) — requer conta comercial verificada pela Med Fusion (passo manual,
# fora do código). Deixar em branco em local para o envio de WhatsApp ser pulado silenciosamente.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Usuário técnico inicial, criado pelo seeder (api #34). Nunca commitar valores reais — só este
# arquivo de exemplo vai para o repositório.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@medfusion.local
ADMIN_PASSWORD=

# Observabilidade — métricas de requests HTTP e de queries, via keepsuit/laravel-opentelemetry,
# empurradas por OTLP direto pro Grafana Cloud (sem daemon/agente — ver docs/ambientes.md §
# Monitoramento). Desligado por padrão de propósito: sem credencial o SDK tentaria um POST a cada
# request, e o CI copia este arquivo como está (.github/workflows/tests.yml). Ligue só depois de
# preencher endpoint e header abaixo com as credenciais do seu stack no Grafana Cloud.
OTEL_SDK_DISABLED=true

# Vira o label "job" no Grafana.
OTEL_SERVICE_NAME=medfusion-os-api

# Identifica a réplica — vira o label "instance". Em branco, config/opentelemetry.php cai em
# gethostname(). NUNCA deixe o pacote gerar sozinho: o default dele é um id aleatório A CADA
# REQUEST, o que cria uma série de métrica nova por requisição.
OTEL_SERVICE_INSTANCE_ID=

# Separa local de produção nos painéis (em produção: deployment.environment.name=production).
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# Endpoint OTLP do seu stack no Grafana Cloud (o SDK acrescenta /v1/metrics sozinho).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<região>.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Basic auth do Grafana Cloud: base64("<instanceID>:<token>"). O portal já entrega a linha pronta
# — copie de lá, não monte o base64 à mão. As ASPAS são obrigatórias (o valor tem "=" dentro).
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64>"

# Cumulative — testado contra o gateway do Grafana Cloud em 17/09/2026: Delta (a escolha teórica
# mais correta pra PHP, onde cada request é um processo novo) foi recusada com "Bad Request". Ver
# docs/ambientes.md § Monitoramento.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=Cumulative
