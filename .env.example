APP_NAME="Med Fusion OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# URL do frontend Angular, usada para montar o CORS e links de retorno.
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Em produção (Laravel Cloud) estas quatro são injetadas automaticamente pela plataforma
# quando um cluster Laravel MySQL é anexado ao environment — não sobrescrever no painel.
# Ver docs/ambientes.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medfusion_os
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=database

QUEUE_CONNECTION=database

# Em produção: driver S3-compatível do Laravel Cloud Object Storage (credenciais injetadas
# automaticamente pela plataforma). Em local, "local" é suficiente — a v1 não depende de
# arquivos persistentes fora do fluxo de geração de PDF.
FILESYSTEM_DISK=local

# Notificação automática da OS por e-mail e WhatsApp (ver docs/ambientes.md e
# docs/api-conventions.md). Em local, usar o Mailtrap/log driver para não enviar de verdade.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="naoresponda@medfusion.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Cloud API (Meta) — requer conta comercial verificada pela Med Fusion (passo manual,
# fora do código). Deixar em branco em local para o envio de WhatsApp ser pulado silenciosamente.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Usuário técnico inicial, criado pelo seeder (api #34). Nunca commitar valores reais — só este
# arquivo de exemplo vai para o repositório.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@medfusion.local
ADMIN_PASSWORD=
